<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback card shown behind the rendered PNG: matches the app's dark
     surface so a freshly-placed widget reads as a branded card, not a void,
     until its first render completes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#252529" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#3E3E48" />
</shape>
